<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><IsPackable>false</IsPackable></PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../EscalaEasy.Domain/EscalaEasy.Domain.csproj" />
    <ProjectReference Include="../EscalaEasy.Application/EscalaEasy.Application.csproj" />
    <ProjectReference Include="../EscalaEasy.Infrastructure/EscalaEasy.Infrastructure.csproj" />
    <ProjectReference Include="../EscalaEasy.Api/EscalaEasy.Api.csproj" />


  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../EscalaEasy.Domain/EscalaEasy.Domain.csproj" Link="ArchitectureInputs/Domain.csproj" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../EscalaEasy.Domain/**/*.cs" Exclude="../EscalaEasy.Domain/obj/**;../EscalaEasy.Domain/bin/**" Link="ArchitectureInputs/Domain/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../EscalaEasy.Application/EscalaEasy.Application.csproj" Link="ArchitectureInputs/Application.csproj" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../EscalaEasy.Application/**/*.cs" Exclude="../EscalaEasy.Application/obj/**;../EscalaEasy.Application/bin/**" Link="ArchitectureInputs/Application/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../EscalaEasy.Infrastructure/EscalaEasy.Infrastructure.csproj" Link="ArchitectureInputs/Infrastructure.csproj" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../EscalaEasy.Infrastructure/**/*.cs" Exclude="../EscalaEasy.Infrastructure/obj/**;../EscalaEasy.Infrastructure/bin/**" Link="ArchitectureInputs/Infrastructure/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../EscalaEasy.Api/EscalaEasy.Api.csproj" Link="ArchitectureInputs/Api.csproj" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../EscalaEasy.Api/**/*.cs" Exclude="../EscalaEasy.Api/obj/**;../EscalaEasy.Api/bin/**" Link="ArchitectureInputs/Api/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../EscalaEasy.Analysis.Tests/EscalaEasy.Analysis.Tests.csproj" Link="ArchitectureInputs/Tests/Analysis.csproj" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../EscalaEasy.Adapter.Tests/EscalaEasy.Adapter.Tests.csproj" Link="ArchitectureInputs/Tests/Adapter.csproj" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
